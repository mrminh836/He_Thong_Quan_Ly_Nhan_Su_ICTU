# ==============================================================================
# HỆ THỐNG QUẢN LÝ NHÂN SỰ (HRM - ICTU) - MẪU BIẾN MÔI TRƯỜNG DÙNG CHUNG
# Hướng dẫn: Sao chép tệp này thành .env trước khi khởi chạy ứng dụng hoặc Docker:
#   Windows CMD/PowerShell: copy .env.example .env
#   Linux/macOS:            cp .env.example .env
# Lưu ý: Tuyệt đối không commit tệp .env thật lên Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH DOCKER COMPOSE PORT (MÁY HOST)
# ------------------------------------------------------------------------------
# Cổng truy cập ứng dụng Frontend trên trình duyệt (http://localhost:5173)
FRONTEND_PORT=5173

# Cổng truy cập API Backend trên máy host (http://localhost:3005)
PORT=3005

# Cổng kết nối MySQL từ máy host (DBeaver/Navicat/Workbench: localhost:3309)
DB_PORT=3309

# Cổng truy cập giao diện quản trị cơ sở dữ liệu phpMyAdmin (http://localhost:8084)
PMA_PORT=8084

# Cổng truy cập bảo mật HTTPS Nginx Reverse Proxy (https://hrm.local:443)
HTTPS_PORT=443

# Cổng truy cập Grafana Dashboard trên máy host (http://localhost:3001)
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Admin@Pass2026

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL (db service)
# ------------------------------------------------------------------------------
# Tên Database chính
DB_NAME=hrm_db

# Tài khoản ứng dụng (Least Privilege) dùng cho Backend
DB_USER=app_user
DB_PASSWORD=AppUser@Pass2026

# Tài khoản chỉ đọc (Read-only) dùng cho Báo cáo, Thống kê, BI và Exporter
DB_REPORT_USER=report_user
DB_REPORT_PASSWORD=ReportUser@Pass2026

# Mật khẩu tài khoản Quản trị viên MySQL (Chỉ dùng cứu hộ DB, không dùng cho Backend)
DB_ROOT_PASSWORD=RootPassword@2026

# Host kết nối DB:
# - Khi chạy trong Docker Compose: dùng tên service 'db'
# - Khi chạy backend trực tiếp bằng node local trên máy host: dùng 'localhost'
DB_HOST=db

# Giới hạn connection pool MySQL
DB_CONNECTION_LIMIT=10

# Khóa bí mật mã hóa / giải mã CCCD bằng MySQL AES_ENCRYPT
CCCD_ENCRYPTION_KEY=ICTU_HRM_SECRET_KEY_2026_AES256_DEV
DB_AES_SECRET_KEY=ICTU_HRM_SECRET_KEY_2026_AES256_DEV

# Khóa bí mật riêng biệt băm HMAC-SHA-256 CCCD dùng để kiểm tra trùng lặp an toàn
CCCD_HMAC_SECRET=ICTU_HRM_CCCD_HMAC_SECRET_2026_KEY_DEV

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH BACKEND SERVICE (backend)
# ------------------------------------------------------------------------------
NODE_ENV=development

# Khóa ký và xác thực JSON Web Token (JWT)
JWT_SECRET=ICTU_HRM_JWT_SECRET_KEY_2026_SUPER_SECURE_DEV

# Thời hạn hiệu lực của Token
JWT_EXPIRES_IN=8h

# Số vòng băm muối Bcrypt
BCRYPT_SALT_ROUNDS=10

# Cấu hình CORS (cho phép frontend gọi API)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH FRONTEND (frontend)
# ------------------------------------------------------------------------------
# Địa chỉ URL gọi API Backend từ trình duyệt người dùng
VITE_API_BASE_URL=http://localhost:3005/api
