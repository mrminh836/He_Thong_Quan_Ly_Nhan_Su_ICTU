# ==============================================================================
# HỆ THỐNG QUẢN LÝ NHÂN SỰ (HRM - ICTU) - BIẾN MÔI TRƯỜNG BACKEND (.env.example)
# Hướng dẫn: Sao chép tệp này thành .env trong thư mục backend trước khi chạy:
#   copy .env.example .env (Windows) hoặc cp .env.example .env (Linux/macOS)
# ==============================================================================

# 1. CẤU HÌNH SERVER ỨNG DỤNG
NODE_ENV=development
PORT=3005
CORS_ORIGIN=*

# 2. CẤU HÌNH KẾT NỐI DATABASE MYSQL
# LƯU Ý KHI CHẠY TRONG DOCKER COMPOSE:
#   DB_HOST=db (tên service MySQL trong compose.yaml)
#   DB_PORT=3306 (port nội bộ của container db)
# LƯU Ý KHI CHẠY TRỰC TIẾP TRÊN MÁY HOST (npm run dev):
#   DB_HOST=127.0.0.1
#   DB_PORT=3309 (cổng đã ánh xạ ra host tránh trùng với 3306/3308)
DB_HOST=db
DB_PORT=3306
DB_NAME=hrm_db
DB_USER=app_user
DB_PASSWORD=AppUser@Pass2026
DB_ROOT_PASSWORD=RootPassword@2026

# Cấu hình Connection Pool
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# 3. BẢO MẬT XÁC THỰC, MẬT KHẨU & JWT (AUTH & SECURITY)
# Khóa bí mật mã hóa / giải mã CCCD bằng MySQL AES_ENCRYPT
CCCD_ENCRYPTION_KEY=ICTU_HRM_SECRET_KEY_2026_AES256
DB_AES_SECRET_KEY=ICTU_HRM_SECRET_KEY_2026_AES256

# Khóa bí mật riêng biệt dùng để băm HMAC-SHA-256 CCCD phục vụ kiểm tra trùng lặp an toàn
CCCD_HMAC_SECRET=ICTU_HRM_CCCD_HMAC_SECRET_2026_KEY

# Khóa bí mật ký JSON Web Token (JWT) - Bắt buộc thay đổi chuỗi ngẫu nhiên mạnh khi production!
JWT_SECRET=ICTU_HRM_JWT_SECRET_KEY_2026_SUPER_SECURE_DEV

# Thời hạn hiệu lực của JWT Access Token (vd: 15m, 1h, 8h, 24h)
JWT_EXPIRES_IN=8h

# Số vòng băm muối mật khẩu Bcrypt (Tối thiểu 10 vòng, khuyến nghị 12 cho production)
BCRYPT_SALT_ROUNDS=10
