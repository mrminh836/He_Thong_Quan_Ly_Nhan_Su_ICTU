# ==============================================================================
# HỆ THỐNG QUẢN LÝ NHÂN SỰ (HRM - ICTU) - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================

# 1. CẤU HÌNH SERVER ỨNG DỤNG
NODE_ENV=development
PORT=3005
CORS_ORIGIN=*

# 2. CẤU HÌNH KẾT NỐI DATABASE MYSQL
# LƯU Ý KHI CHẠY DOCKER COMPOSE:
#   DB_HOST=db (tên service MySQL trong compose.yaml)
#   DB_PORT=3306 (port nội bộ của container db)
# LƯU Ý KHI CHẠY TRỰC TIẾP TRÊN MÁY HOST (npm run dev):
#   DB_HOST=127.0.0.1
#   DB_PORT=3308 (cổng đã ánh xạ ra host tránh trùng với 3306/3307)
DB_HOST=db
DB_PORT=3306
DB_NAME=hrm_db
DB_USER=app_user
DB_PASSWORD=AppUser@Pass2026
DB_ROOT_PASSWORD=RootPassword@2026

# Cấu hình Connection Pool
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# 3. KHÓA BẢO MẬT & MÃ HÓA (LAB 6)
DB_AES_SECRET_KEY=ICTU_HRM_SECRET_KEY_2026_AES256
JWT_SECRET=ICTU_HRM_JWT_SECRET_KEY_2026_SUPER_SECURE
JWT_EXPIRES_IN=24h
